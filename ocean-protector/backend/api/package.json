{
  "name": "oceanguard-api",
  "version": "1.0.0",
  "description": "OceanGuard Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/database/migrate.ts",
    "migrate:prod": "node dist/database/migrate.js",
    "seed:demo": "tsx src/scripts/seed-demo-users.ts",
    "seed:demo:prod": "node dist/scripts/seed-demo-users.js",
    "start:render": "npm run migrate:prod && (npm run seed:demo:prod || echo 'Demo seed skipped (non-fatal)') && npm start"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "supertest": "^6.3.3",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "vitest": "^1.0.1"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
